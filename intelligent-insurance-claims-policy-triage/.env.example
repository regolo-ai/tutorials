# ==============================================================================
# Regolo.ai & Insurance Triage Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Regolo Inference Gateway Credentials
# ------------------------------------------------------------------------------
# Get your API key at: https://regolo.ai
REGOLO_API_KEY=your_regolo_api_key_here
REGOLO_BASE_URL=https://api.regolo.ai/v1

# ------------------------------------------------------------------------------
# 2. Complexity Routing Model (Stage 2)
# ------------------------------------------------------------------------------
# The hosted complexity classifier that grades requests easy, medium, or hard.
# Verified available model: 'brick-complexity-pro'
REGOLO_COMPLEXITY_MODEL=brick-complexity-pro

# ------------------------------------------------------------------------------
# 3. Case Brief Generative Models (Stage 3 - Selected by Complexity)
# ------------------------------------------------------------------------------
# Verified models available in Regolo catalog:
#   - Advanced tier (used for 'hard' complexity or 'high' priority emergencies):
REGOLO_ADVANCED_MODEL=qwen3.5-122b

#   - Standard tier (used for 'medium' complexity requests):
REGOLO_STANDARD_MODEL=qwen3.8-27b

#   - Fast/Efficient tier (used for routine 'easy' requests to minimize cost):
REGOLO_FAST_MODEL=qwen3.5-9b

# ------------------------------------------------------------------------------
# 4. Non-Autoregressive Classifier Backend (Stage 1)
# ------------------------------------------------------------------------------
# Options:
#   - 'setfit'  : Uses local fine-tuned SetFit bi-encoder (models/setfit-insurance-triage, ~10ms CPU, 95% Acc)
#   - 'laya'    : Uses zero-shot ModernBERT-large model (convaiinnovations/laya)
#   - 'mock'    : Deterministic rule fallback for offline testing
CLASSIFIER_BACKEND=setfit

# Minimum confidence threshold to allow automated triage (selective risk gating).
# Below this threshold, requests fail closed to the human review queue.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.85
