# Regolo API key (https://regolo.ai). Never commit the real .env file.
REGOLO_API_KEY=
REGOLO_BASE_URL=https://api.regolo.ai

# Secret for HMAC pseudonymisation of IBANs, device ids, customer ids.
# Rotate per environment; changing it changes every pseudonym in the audit log.
FRAUDCLEF_HMAC_KEY=change-me
