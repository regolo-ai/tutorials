# Get your free API key, sign up at https://regolo.ai/signup and generate one from your dashboard.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.regolo.ai/v1

# Modelli differenziati per ruolo
THINKER_MODEL=gpt-4o
WORKER_MODEL=gpt-4o
VERIFIER_MODEL=gpt-4o

# Fallback se non definiti i modelli sopra
OPENAI_MODEL_NAME=gpt-4o

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TWV_MAX_RETRIES=2
TWV_MAX_REASSIGNS=2
TWV_MAX_REPLANS=2
TWV_VERBOSE=true
