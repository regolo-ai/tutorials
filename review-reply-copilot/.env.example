# Regolo API key (https://regolo.ai). Inference on Regolo has zero data retention.
REGOLO_API_KEY=replace_me
REGOLO_BASE_URL=https://api.regolo.ai/v1
REGOLO_ADMIN_URL=https://api.regolo.ai
# Writes the draft replies. Clef-Flash decides and checks.
REGOLO_CHAT_MODEL=qwen3.8-27b
REGOLO_DECISION_MODEL=clef-flash
# "none" turns reasoning off for the writing model (about 1 s per reply instead of 5 to 70 s). Use "default" to leave it on.
REGOLO_REASONING_EFFORT=none


HOST=127.0.0.1
PORT=8100
