# =====================================================================
# Regolo.ai API Configuration
# Get your API key from https://regolo.ai
# =====================================================================
REGOLO_API_KEY=your_regolo_api_key_here
REGOLO_BASE_URL=https://api.regolo.ai/v1

# Meta-Router Model (Brick Semantic Routing & Complexity Evaluation)
MODEL_BRICK_ROUTER=brick-complexity-pro

# Global Default Model Fallback
REGOLO_MODEL=GLM5.2

# =====================================================================
# Granular Deep Agent Sub-Agent Model Routing (Regolo.ai Catalog)
# Available models: GLM5.2, qwen3.5-122b, Llama-3.3-70B-Instruct, gpt-oss-20b
# =====================================================================

# 1. Planner (DAG Decomposition, Dependency Graph & Budget Allocation)
MODEL_PLANNER_PREFERRED=qwen3.5-122b
MODEL_PLANNER_FALLBACK=GLM5.2

# 2. Researcher (API Contract Analysis, Signature Extraction, Edge Cases)
MODEL_RESEARCHER_PREFERRED=gpt-oss-20b
MODEL_RESEARCHER_FALLBACK=GLM5.2

# 3. Browser / Tool Agent (Mock Schemas, Live Endpoint Probing, MCP Ping)
MODEL_TOOL_AGENT_PREFERRED=GLM5.2
MODEL_TOOL_AGENT_FALLBACK=gpt-oss-20b

# 4. Code Executor (MCP Tool Synthesis, Pydantic Schema, Sandbox Unit Tests)
MODEL_CODE_EXECUTOR_PREFERRED=Llama-3.3-70B-Instruct
MODEL_CODE_EXECUTOR_FALLBACK=GLM5.2

# 5. Reviewer (Schema Strictness, Context Efficiency, Injection Guardrails)
MODEL_REVIEWER_PREFERRED=qwen3.5-122b
MODEL_REVIEWER_FALLBACK=GLM5.2

# 6. Report Writer (Agent Tool Harness Spec, Benchmark Synthesis)
MODEL_REPORT_WRITER_PREFERRED=GLM5.2
MODEL_REPORT_WRITER_FALLBACK=gpt-oss-20b

# 7. Budget Controller (Token Spend Tracking & Dynamic Downscale/Escalation)
MODEL_BUDGET_CONTROLLER=gpt-oss-20b

# =====================================================================
# Dynamic Routing & Budget Governance Constraints
# =====================================================================
TOTAL_PIPELINE_TOKEN_BUDGET=25000
BUDGET_WARNING_THRESHOLD=0.75
ENABLE_SEMANTIC_ROUTING=true
ENABLE_DYNAMIC_ESCALATION=true

# =====================================================================
# Background Services (Docker Services for MCP Tool Sandbox & Vector Store)
# =====================================================================
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
MCP_SANDBOX_HOST=127.0.0.1
MCP_SANDBOX_PORT=8900
