# =====================================================================
# Regolo API Configuration
# Get your API key from https://regolo.ai
# =====================================================================
REGOLO_API_KEY=your_regolo_api_key_here
REGOLO_BASE_URL=https://api.regolo.ai/v1

# Global default model (fallback for all stages)
REGOLO_MODEL=brick-complexity-pro

# =====================================================================
# Granular Per-Stage Model Routing through Brick Complexity Pro to the right model or you can 
# choose individual models for each phase based on budget and reasoning requirements.
#
# Available tested models on Regolo:
#  - GLM-5.2                : Balanced general reasoning & code synthesis
#  - qwen3.5-122b           : Deep reasoning, architectural planning & complex validation
#  - Llama-3.3-70B-Instruct  : High-throughput code implementation & refactoring
#  - gpt-oss-20b            : Fast & lightweight triage, classification, graph extraction
# =====================================================================

# 1. Open SWE: Issue Classification & Triage
MODEL_OPEN_SWE_CLASSIFY=brick-complexity-pro

# 2. Open SWE: Architecture & Remediation Planning
MODEL_OPEN_SWE_PLAN=brick-complexity-pro

# 3. Open SWE: Code Generation & Sandbox Patch Implementation
MODEL_OPEN_SWE_EXECUTE=brick-complexity-pro

# 4. Deepsec: SAST & AST Security Vulnerability Scanner
MODEL_DEEPSEC_SCAN=brick-complexity-pro

# 5. Deepsec: Patch Revalidation & Regression Gate
MODEL_DEEPSEC_REVALIDATE=brick-complexity-pro

# 6. Cognee: Knowledge Graph & Memory Pattern Extraction
MODEL_COGNEE_EXTRACT=brick-complexity-pro

# =====================================================================
# Background Services (Qdrant & Cognee Docker Endpoints)
# =====================================================================
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
COGNEE_API_URL=http://127.0.0.1:8800
